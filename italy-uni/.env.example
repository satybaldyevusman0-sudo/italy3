# Бул файлды .env деп көчүрүп, өз ачкычтарыңызды жазыңыз (милдеттүү эмес — жок болсо демо режим иштейт)

# Telegram бот: @BotFather аркылуу бот түзүп, токенди жана chat_id жазыңыз
VITE_TG_TOKEN=
VITE_TG_CHAT_ID=

# EmailJS (https://www.emailjs.com) — почтага заказ жөнөтүү
VITE_EMAILJS_SERVICE=
VITE_EMAILJS_TEMPLATE=
VITE_EMAILJS_PUBLIC_KEY=

# Cloudinary — сүрөт жүктөө (unsigned upload preset)
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# Google OAuth Client ID (https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=
# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=

# Сырткы REST API (мисалы mockapi.io). Бош болсо /api/*.json + localStorage колдонулат
VITE_API_URL=
